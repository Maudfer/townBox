    "wander": {
        "label": "Wandering around",
        "type": "continuous",
        "category": "leisure",
        "location": "outside",
        "durationTicks": 4,
        "selection": {
            "weight": 0.9,
            "modifiers": [
                {
                    "when": {
                        "attr": "age",
                        "op": ">=",
                        "value": 65
                    },
                    "multiply": 1.5
                }
            ]
        },
        "children": {
            "mode": "pool",
            "entries": [
                {
                    "action": "sat_on_bench",
                    "chancePerTick": 0.35,
                    "cooldownTicks": 2
                },
                {
                    "action": "greeted_neighbor",
                    "chancePerTick": 0.25,
                    "maxPerTick": 2
                },
                {
                    "action": "found_coin",
                    "chancePerTick": 0.05,
                    "maxTotal": 1
                },
                {
                    "action": "pocketed_small_object",
                    "chancePerTick": 0.1,
                    "requirements": {
                        "objectAtLocation": {
                            "flag": "pocketable"
                        }
                    }
                }
            ]
        }
    },
    "bake_cake": {
        "label": "Baking a cake",
        "type": "continuous",
        "category": "maintenance",
        "location": "home",
        "parameters": {
            "recipe": {
                "type": "recipe",
                "required": false
            }
        },
        "selection": {
            "weight": 0.4,
            "cooldownTicks": 48
        },
        "children": {
            "mode": "sequence",
            "onStepFailure": "blockParent",
            "steps": [
                {
                    "action": "mix_dough",
                    "params": {
                        "recipe": "$parent.recipe"
                    }
                },
                {
                    "action": "bake_dough"
                },
                {
                    "action": "add_topping",
                    "params": {
                        "topping": "$previous.output"
                    }
                }
            ]
        }
    },
