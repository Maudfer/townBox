# Generated files are compared byte-for-byte by checked-diff tests (test/util/simulationDocs.test.ts,
# test/events/eventClassification.test.ts); keep them LF on every platform so local runs match CI and
# the generator output.
docs/generated/simulation-relationships.md text eol=lf
docs/generated/event-classification.md text eol=lf

# Integration scenario fixtures are single-line base64 save payloads; never EOL-normalize them so the
# committed bytes are identical on every platform.
test/integration/fixtures/*.txt text eol=lf


# History-asset payloads are base64 chunk files whose exact bytes matter (person files are newline-separated
# compressed chunks); never EOL-convert them.
src/history/**/*.tbz text eol=lf
